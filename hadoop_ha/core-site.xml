<configuration>
    <!-- 使用 HA 集群名称替代单个 NameNode -->
    <property>
        <name>fs.defaultFS</name>
        <value>hdfs://mycluster</value>
    </property>

    <property>
        <name>hadoop.tmp.dir</name>
        <value>/opt/hadoop/tmp</value>
    </property>

    <!-- ZooKeeper 配置 -->
    <property>
        <name>ha.zookeeper.quorum</name>
        <value>node0:2181,node1:2181,node2:2181</value>
    </property>
</configuration>